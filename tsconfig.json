{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite-plus/client"]
  },
  "include": [
    "vite.config.ts",
    "apps/cloudflare/src",
    "apps/cloudflare/scripts",
    "apps/cloudflare/tests",
    "apps/cloudflare/*.ts",
    "apps/cloudflare/.cloudflare/types",
    "packages/omp-sdk/src",
    "packages/omp-sdk/tests",
    "packages/omp-sdk/vite.config.ts"
  ],
  "exclude": ["apps/cloudflare/src/web"]
}
