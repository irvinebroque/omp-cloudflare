{
  // Deploy-button metadata. cf reads name and compatibility_date from this file.
  // Worker behavior and bindings are configured in apps/cloudflare/cloudflare.config.ts.
  "name": "omp-cloudflare",
  "main": "apps/cloudflare/src/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "omp-cloudflare" }],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "MemoryAgent", "class_name": "MemoryAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MemoryAgent"] }],
}
