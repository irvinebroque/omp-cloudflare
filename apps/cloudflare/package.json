  "repository": {
    "type": "git",
    "url": "git+https://github.com/irvinebroque/omp-cloudflare.git"
  },
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "vpx scripts/deploy.ts",
