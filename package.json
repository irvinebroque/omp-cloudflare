{
  "name": "omp-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "An Open Memory Protocol v0.5 example on Cloudflare Workers and Artifacts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irvinebroque/omp-cloudflare.git"
  },
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "vpx scripts/deploy.ts",
    "typecheck": "cf workers types && tsc && tsc -p src/web",
    "roundtrip": "vpx scripts/roundtrip.ts",
    "mcp:roundtrip": "vpx scripts/mcp-roundtrip.ts",
    "codex:setup": "vpx scripts/setup-codex.ts",
    "codex:check": "vpx scripts/check-codex.ts",
    "check": "cf workers types && vp check --deny-warnings && tsc -p src/web",
    "lint": "cf workers types && vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "codex:roundtrip": "vpx scripts/codex-memory-roundtrip.ts",
    "regression:roundtrip": "vpx scripts/regression-roundtrip.ts",
    "test": "vp test run",
    "test:e2e": "vpx scripts/test-e2e.ts",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e",
    "concurrency:roundtrip": "vpx scripts/concurrency-roundtrip.ts",
    "agent:roundtrip": "vpx scripts/agent-roundtrip.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "~1.5.0",
    "@earendil-works/pi-ai": "~1.5.0",
    "@earendil-works/pi-durable": "~1.5.0",
    "@earendil-works/pi-schema": "~1.5.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "isomorphic-git": "1.44.11",
    "memfs": "^4.80.0",
    "picomatch": "^4.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "cf": "^1.0.0-beta.17",
    "json5": "2.2.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "engines": {
    "node": "^24.22.0 || ^26.12.0"
  },
  "packageManager": "npm@11.19.1",
  "cloudflare": {
    "bindings": {
      "MEMORY_API_TOKEN": {
        "description": "The private access key for this demo. Generate at least 24 characters with `openssl rand -hex 32` and save the value: you will paste it into Connect → Access key. It unlocks chat and both memory stores. Use the same value as OMP_API_TOKEN for clients."
      }
    }
  }
}
